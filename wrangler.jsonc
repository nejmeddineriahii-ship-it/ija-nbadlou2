{
  // Nom du Worker : garde EXACTEMENT le même nom que ton Worker actuel sur Cloudflare
  // (sinon un nouveau Worker serait créé et le domaine ija-nbadlou.tn resterait branché sur l'ancien).
  "name": "ija-nbadlou2",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // le Worker s'exécute d'abord seulement pour ces chemins ; le reste est servi directement
    "run_worker_first": ["/annonce/*", "/img/*", "/sitemap.xml"]
  }
}
